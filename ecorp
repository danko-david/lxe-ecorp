#!/bin/bash

# helper script
# Used to wrap custom operations inside one script
############################# RH helper functions ##############################

ECORP_VERSION=1.2.0

trapERR()
{
	ex=$?
	echo ">> Failing command is '$BASH_COMMAND' on line $BASH_LINENO and status is $ex <<" >&2
	exit $ex
}
trap trapERR ERR

ROOT=$(dirname $(readlink -f $0))

_rh_try_ret_help()
{
	if [ ! -z $RH_RUNTIME_REQUEST_HELP ]
	then
		echo $1
		exit 1;
	fi
}

spawn_default()
{
	cd ${ROOT}
	cd $2
	if ! [ -e $3 ]
	then
		if [ $1 = 'plain' ]
		then
			cp $3'.default' $3
		elif [ $1 = 'eval' ]
		then
			bash <(echo 'cat << EOF' ; cat $3'.default' ; echo 'EOF') > $3
		fi
	fi
	cd ${ROOT}
}

prepare()
{
	_rh_try_ret_help 'Do the necessary preparation steps before launching: spawning default config files, creating directories'

	cd ${ROOT}

	mkdir -p data/dns/zones/ data/storage

	spawn_default eval . .env
	spawn_default plain settings ad-users.yml
	spawn_default plain settings steps.yml
}

dc()
{
	docker compose -p ecorp "$@"
}

up()
{
	_rh_try_ret_help 'Starts the infrastructure and follows until ready'
	set -e

	cd ${ROOT}

	prepare
	dc up -d --build
	follow_provision
}

follow_provision()
{
	_rh_try_ret_help 'Follow current provisioning process output running in container until the end'
	dc exec controller /ecorp/units/controller/code/ecorp follow_provision
}

provision()
{
	_rh_try_ret_help 'Run provision in controller'
	dc exec controller /ecorp/units/controller/code/ecorp controller_ansible_provision
}

ensure_wrap_base_image()
{
	cd ${ROOT}
	docker build ${IMAGE_BUILD_OPTS} -t ecorp-wrap-base -f dev/ecorp_wrap_base.Dockerfile dev
}

build_source_image()
{
	# Image with this project copied to /ecorp. Only what git would commit gets
	# in: no ignored file (.env, settings/*.yml, data) and no .git
	ensure_wrap_base_image
	cd ${ROOT}
	files=$(git ls-files -co --exclude-standard) || { echo "Building the image needs a git checkout of the project" >&2; exit 1; }
	for f in $files
	do
		if [ -e $f ]; then echo $f; fi
	done | tar c -T - | docker build -t ecorp-diorama-build-base -f dev/ecorp_diorama_build_base.Dockerfile -
}

run_in_container()
{
	_rh_try_ret_help 'Launch the ecorp infrastructure in a container'
	
	ensure_wrap_base_image

	cd ${ROOT}
	cd dev/wrap_container
	dc up -d
	cat << EOF | dc exec -T ecorp bash
	set -ex
	/source/ecorp wait_docker_ready
	# disable raw protection prevents accessing containers routed style
	# iptables -t raw -I PREROUTING 1 -j ACCEPT

git config --global --add safe.directory /source/.git
git clone /source ecorp
cd ecorp
./ecorp up

	echo ""
	echo "To make this internal network segment available on host machine, add this route:"
	echo "route add -net \$(source ./.env; echo \$NET_CIDR) gw \$(hostname -i)"
EOF

# cycle in container:
# docker compose down -v ; git clean -fxd ; git pull origin master ; ./ecorp up ; docker logs -f ecorp-controller-1

}

ci_test_infra()
{
	_rh_try_ret_help 'CI/CD: Launch the ecorp infrastructure in a container for testing.'
	build_source_image
	cd ${ROOT}
	cd dev/ci_test
	docker compose -p ci_test up -d

	cleanup()
	{
		ex=$?
		docker compose -p ci_test down -v || true
		exit $ex
	}

	trap cleanup EXIT

	cat << EOF | docker compose -p ci_test exec -T ecorp bash
	set -ex
	cd /ecorp
	./ecorp wait_docker_ready
	# stdin is this script: keep the commands from reading it
	./ecorp up < /dev/null
	./ecorp run_tests_install < /dev/null
EOF
}

diorama_registry()
{
	# REPO is the prefix of the published image name: "lxeu/" on Docker Hub,
	# "registry.example.com/group/" on another registry
	if [ -z "$REPO" ] && [ ! -z "$DOCKER_REGISTRY" ]
	then
		REPO=${DOCKER_REGISTRY}/
	fi

	if [ ! -z "$DOCKER_REGISTRY_USERNAME" ]
	then
		echo "$DOCKER_REGISTRY_PASSWORD" | docker login $DOCKER_REGISTRY -u "$DOCKER_REGISTRY_USERNAME" --password-stdin
	fi
}

diorama_publish()
{
	# Name the image just built as ${REPO}ecorp-diorama:$1, and as "latest" if
	# not prevented. Push them if there is a REPO.
	tags=$1
	if [ -z "$NOT_LATEST" ]
	then
		tags="$tags latest"
	fi

	for tag in $tags
	do
		docker tag ecorp-diorama:$ECORP_VERSION ${REPO}ecorp-diorama:$tag
		if [ ! -z "$REPO" ]
		then
			docker push ${REPO}ecorp-diorama:$tag
		fi
	done
}

ci_ensure_diorama()
{
	_rh_try_ret_help 'CI/CD: Build and publish the ecorp-diorama image if the current version is not in the registry yet.'
	diorama_registry

	if [ -z "$FORCE_BUILD_IMAGE" ] && docker pull ${REPO}ecorp-diorama:${ECORP_VERSION}
	then
		echo "Version already present ${REPO}ecorp-diorama:${ECORP_VERSION}"
		exit 0
	fi

	build_diorama_image
	diorama_publish ${ECORP_VERSION}
}

ci_weekly_diorama()
{
	_rh_try_ret_help 'CI/CD: Rebuild the ecorp-diorama image on the newest base images and publish it as <version>-w<week of the year>. Meant for a weekly schedule.'
	diorama_registry

	IMAGE_BUILD_OPTS="--pull --no-cache"
	build_diorama_image
	diorama_publish ${ECORP_VERSION}-w$(date +%V)
}

wait_docker_ready()
{
	rem=30
	while ! service docker start && ! docker ps && [ $rem '>' 0 ]
	do
		rem=$(expr $rem - 1)
		sleep 1
		echo "Waiting secounds remaining: "$rem
	done
	docker ps
}

inside_diorama__build()
{
	# used only inside image building
	set -ex
	wait_docker_ready

	cd /ecorp
	./ecorp up
	docker buildx prune -af
	service docker stop
	service containerd stop

	mkdir /seed_data
	cp -pfr /var/lib/docker /seed_data/ || true
	cp -pfr /var/lib/containerd /seed_data/ || true
}

inside_diorama__launch()
{
	# On first start
	if ! [ -d /var/lib/docker/containers ]
	then
		cp -pfr /seed_data/docker/* /var/lib/docker
		cp -pfr /seed_data/containerd/* /var/lib/containerd
	fi
	exec /usr/sbin/init
}

build_diorama_image()
{
	_rh_try_ret_help 'Build ecorp-diorama image: an image contains this stack installed and ready to start'
	build_source_image

	cleanup()
	{
		ex=$?
		docker stop ecorp_diorama_builder_container || true
		docker rm ecorp_diorama_builder_container || true
		docker volume rm ecorp_diorama_builder_docker ecorp_diorama_builder_containerd || true
		exit $ex
	}

	trap cleanup EXIT

	set -ex

	docker run \
	-d \
	-it \
	--cap-add=ALL \
	--security-opt seccomp=unconfined \
	--security-opt apparmor=unconfined \
	--security-opt systempaths=unconfined \
	--tmpfs /tmp \
	--tmpfs /run \
	-v /sys/fs/cgroup:/sys/fs/cgroup \
	-v ecorp_diorama_builder_docker:/var/lib/docker \
	-v ecorp_diorama_builder_containerd:/var/lib/containerd \
	--name ecorp_diorama_builder_container \
		ecorp-diorama-build-base

	docker exec ecorp_diorama_builder_container /ecorp/ecorp inside_diorama__build
	docker stop ecorp_diorama_builder_container
	docker commit ecorp_diorama_builder_container ecorp-diorama:$ECORP_VERSION
	docker image tag ecorp-diorama:$ECORP_VERSION ecorp-diorama:latest
}

run_test_dir()
{
	cd ${ROOT}
	failed=0
	for t in $1/*${2}*
	do
		if out=$($t 2>&1)
		then
			echo "ok   $(basename $t)"
		elif [ $? = 77 ]
		then
			echo "skip $(basename $t): $out"
		else
			echo "FAIL $(basename $t)"
			echo "$out" | sed 's/^/\t/'
			failed=$(expr $failed + 1)
		fi
	done

	if [ $failed != 0 ]
	then
		echo "$failed test(s) failed"
		exit 1
	fi
}

run_tests()
{
	_rh_try_ret_help 'Run the offline tests in tests/offline (needs no docker or network). $1: optional part of a test name to select tests'
	run_test_dir tests/offline "$1"
}

run_tests_install()
{
	_rh_try_ret_help 'Run the tests in tests/install against the running, provisioned stack. They restart parts of it. $1: optional part of a test name'
	run_test_dir tests/install "$1"
}

purge()
{
	_rh_try_ret_help 'Purge the system: stops all container, removes the volumes and everything under ./data. Keeps .env and the files in settings'
	cd ${ROOT}
	dc down -v
	# git clean -fxd
	# because of git folders (recognised as sub repositories and excluded from clean)
	rm -Rf ./data/*
}

############################ RH built-in functions #############################

help()
{
	_rh_try_ret_help "Returns RH help with the list of all annotated functions"

	echo "RH stands for 'right hand'. It is a wrapper script wherein you can collect tiny commands."
	echo "Specify one righthand function from the followings:"

	RH_RUNTIME_REQUEST_HELP=true

	for f in ${RH_FUNCTIONS[@]}
	do
		# if the command has help
		if type $f | grep -qzP '{\s+_rh_try_ret_help '
		then
			echo -e "\t$f - "$($f)
		fi
	done
}

############################## Application area ################################

# Collection available commands
RH_FUNCTIONS=()

for func in `typeset -F | grep -Po '(?<=-f).*$' | sort`
do
	RH_FUNCTIONS+=($func);
done

# print help if nothing specified

if [ $# '<' '1' ]
then
	help
	exit 1
fi

# run command
for f in ${RH_FUNCTIONS[@]}
do
	if [ "$1" "=" "$f" ]
	then
		$f "${@:2}"
		exit $?
	fi
done

echo "Righthand function $1 not found, so now printing help..."
help
exit 1