#!/bin/bash
. $(dirname $(readlink -f $0))/../lib

tagged_rules()
{
	{ iptables-save -t filter; iptables-save -t raw; } | grep -c -- '--comment ecorp-host-controller' || true
}

[ "$(tagged_rules)" = 2 ] || fail "expected one tagged rule in filter and one in raw, found $(tagged_rules)"

docker stop ecorp-host-controller-1 > /dev/null
left=$(tagged_rules)
docker start ecorp-host-controller-1 > /dev/null

[ "$left" = 0 ] || fail "$left firewall rule(s) stayed on the host after the stop"

sleep 5
[ "$(tagged_rules)" = 2 ] || fail "the rules were not added again at start"
