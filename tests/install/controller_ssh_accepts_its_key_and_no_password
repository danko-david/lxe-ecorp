#!/bin/bash
. $(dirname $(readlink -f $0))/../lib

in_controller ssh -o BatchMode=yes -o StrictHostKeyChecking=no root@localhost true || fail "the controller key was not accepted"

if in_controller sshpass -p password ssh -o StrictHostKeyChecking=no -o PubkeyAuthentication=no -o PreferredAuthentications=password root@localhost true
then
	fail "root could log in with a password"
fi
