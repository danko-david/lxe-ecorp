#!/bin/bash
. $(dirname $(readlink -f $0))/../lib

# one name per line: ticket files have spaces in their names
while IFS= read -r f
do
	shebang=no
	if head -c 2 "$f" | grep -q '^#!'; then shebang=yes; fi
	if [ -x "$f" ] && [ $shebang = no ]
	then
		fail "$f is executable but is not a script"
	fi
	if ! [ -x "$f" ] && [ $shebang = yes ]
	then
		fail "$f is a script but is not executable"
	fi
done < <(project_files)
