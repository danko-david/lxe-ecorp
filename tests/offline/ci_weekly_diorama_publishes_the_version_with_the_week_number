#!/bin/bash
. $(dirname $(readlink -f $0))/../lib

make_sandbox
use_fake_docker
version=$(grep -m 1 -oP '(?<=^ECORP_VERSION=).*' ecorp)
tag=$version-$(date +%gw%V)

REPO=lxeu/ ${SANDBOX}/ecorp ci_weekly_diorama

docker_was_called "^push lxeu/ecorp-diorama:$tag$" || fail "lxeu/ecorp-diorama:$tag was not pushed"
docker_was_called "^push lxeu/ecorp-diorama:latest$" || fail "latest was not moved to the weekly build"
